# ==============================================================================
# Maintenance Copilot - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration
# Default: SQLite for seamless local execution
# PostgreSQL alternative: postgresql+asyncpg://postgres:postgres@localhost:5432/maintenance_copilot
DATABASE_URL=sqlite:///./maintenance_copilot.db

# Embedding & Vector Search
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store
HYBRID_DENSE_WEIGHT=0.6
HYBRID_LEXICAL_WEIGHT=0.4

# LLM Provider Configuration
# Supported options: "mock", "gemini", "openai", "ollama"
LLM_PROVIDER=mock

# Cloud Provider API Keys (leave blank when using "mock" or "ollama")
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434

# Agent Configuration
MAX_AGENT_STEPS=3
TEMPERATURE=0.1
